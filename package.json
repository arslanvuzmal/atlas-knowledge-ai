{
  "name": "atlas-knowledge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Secure RAG knowledge assistant with document ingestion, source-grounded answers, access controls, analytics, and human escalation.",
  "author": "Arslan Vuzmal Lone",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration --project retrieval --project security",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:retrieval": "vitest run --project retrieval",
    "test:security": "vitest run --project security",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:documents": "tsx scripts/build-demo-documents.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && node scripts/audit.mjs && npm run build",
    "portfolio:capture": "playwright test --config=playwright.screenshots.config.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "dotenv": "^16.4.7",
    "mammoth": "^1.9.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^0.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "auditConfig": {
    "ignore": [
      "GHSA-34x7-hfp2-rc4v",
      "GHSA-8qq5-rm4j-mr97",
      "GHSA-83g3-92jg-28cx",
      "GHSA-qffp-2rhf-9h96",
      "GHSA-9ppj-qmqm-q256",
      "GHSA-r6q2-hw4h-h46w",
      "GHSA-vmf3-w455-68vh",
      "GHSA-w8wr-v893-vjvp",
      "GHSA-23hp-3jrh-7fpw",
      "GHSA-8x88-c5mf-7j5w",
      "GHSA-gvwx-54wh-qm9j",
      "GHSA-r292-9mhp-454m",
      "GHSA-f88m-g3jw-g9cj",
      "GHSA-qx2v-qp2m-jg93",
      "GHSA-6g55-p6wh-862q",
      "GHSA-r28c-9q8g-f849",
      "GHSA-fxqj-rqcc-2cmp",
      "GHSA-5p4m-2wfm-xmqj",
      "GHSA-2v37-7h3g-55p8",
      "GHSA-mh99-v99m-4gvg",
      "GHSA-rgw5-rvv9-x895"
    ]
  }
}
