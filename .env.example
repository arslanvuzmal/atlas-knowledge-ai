# =============================================================================
# Atlas Knowledge AI - environment template
# Copy to .env and fill in. NEVER commit the resulting .env file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- Database -----------------------------------------------------------------
# Pooled connection used by the running application.
DATABASE_URL=""
# Direct (non-pooled) connection used by `prisma migrate`. On Supabase this is
# the port 5432 connection string; DATABASE_URL is the port 6543 pooler.
DIRECT_URL=""

# --- Demo mode ----------------------------------------------------------------
# When true the app runs entirely without paid AI credentials using deterministic
# demo providers, and the seeded demo accounts are able to sign in.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# --- Application --------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Secrets (required, minimum 32 characters) --------------------------------
AUTH_SECRET=""
INTERNAL_API_SECRET=""

# --- Storage ------------------------------------------------------------------
# "local" writes to ./storage (development). "supabase" uses Supabase Storage.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_ROOT="./storage"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="atlas-documents"

# --- AI providers -------------------------------------------------------------
# embedding: demo | openai | google | huggingface | ollama
EMBEDDING_PROVIDER="demo"
# llm: demo | openai | anthropic | gemini | openrouter | ollama
LLM_PROVIDER="demo"

# Vector width of the pgvector column. Changing this requires a migration and a
# full re-index of every chunk. See docs/RAG_DESIGN.md.
EMBEDDING_DIMENSIONS="768"

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
HUGGINGFACE_API_KEY=""
OLLAMA_BASE_URL=""

# Optional model overrides. Sensible per-provider defaults apply when blank.
EMBEDDING_MODEL=""
LLM_MODEL=""

# --- Optional external ingestion worker ---------------------------------------
# Left blank in the default all-TypeScript architecture. See docs/DECISIONS.md.
WORKER_URL=""
WORKER_INTERNAL_SECRET=""

# --- Ingestion and retrieval defaults -----------------------------------------
MAX_UPLOAD_SIZE_MB="15"
DEFAULT_CHUNK_SIZE="800"
DEFAULT_CHUNK_OVERLAP="120"
DEFAULT_RETRIEVAL_COUNT="10"
DEFAULT_RERANK_COUNT="5"
DEFAULT_CONFIDENCE_THRESHOLD="0.65"

# --- Guards -------------------------------------------------------------------
# Must be explicitly "true" to allow the seed script to run against a database
# that is not local. Protects production data from accidental reseeding.
ALLOW_PRODUCTION_SEED="false"
