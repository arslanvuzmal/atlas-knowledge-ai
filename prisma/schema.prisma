// Atlas Knowledge AI - relational + vector schema.
// Governance: Governed RAG + Customer Intelligence CRM + Enterprise Operations Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  PUBLIC
  CUSTOMER
  EMPLOYEE
  MANAGER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum Visibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum AccessLevel {
  PUBLIC
  CUSTOMER
  EMPLOYEE
  MANAGER
  ADMIN
}

enum SourceType {
  PDF
  DOCX
  TXT
  MARKDOWN
  CSV
  WEBSITE
  FAQ
  MANUAL_ENTRY
}

enum DocumentStatus {
  UPLOADED
  VALIDATING
  EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXED
  FAILED
  ARCHIVED
}

enum ProcessingStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ConversationStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum GroundingLevel {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
}

enum FeedbackRating {
  HELPFUL
  PARTIALLY_HELPFUL
  NOT_HELPFUL
}

enum FeedbackReason {
  INCORRECT_ANSWER
  MISSING_INFORMATION
  WRONG_SOURCE
  OUTDATED_INFORMATION
  TOO_VAGUE
  ACCESS_ISSUE
  OTHER
}

enum EscalationStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EscalationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EscalationResolutionCategory {
  MISSING_KNOWLEDGE
  OUTDATED_SOURCE
  CONFLICTING_SOURCE
  RETRIEVAL_FAILURE
  ACCESS_PROBLEM
  INCORRECT_ANSWER
  USER_MISUNDERSTANDING
  OTHER
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobStage {
  VALIDATION
  EXTRACTION
  CHUNKING
  EMBEDDING
  INDEXING
  COMPLETE
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  NOT_CONFIGURED
}

enum LifecycleStage {
  VISITOR
  LEAD
  QUALIFIED_LEAD
  OPPORTUNITY
  CUSTOMER
  FORMER_CUSTOMER
}

enum LeadStatus {
  NEW
  OPEN
  WORKING
  WAITING
  QUALIFIED
  UNQUALIFIED
  NURTURE
  CLOSED
}

enum ProvenanceSource {
  PROVIDED
  DERIVED
  IMPORTED
  SYSTEM
  HUMAN_EDITED
}

enum CrmActivityType {
  VISITOR_CREATED
  CONTACT_IDENTIFIED
  CONTACT_UPDATED
  COMPANY_LINKED
  CHAT_STARTED
  CUSTOMER_MESSAGE
  AI_RESPONSE
  HUMAN_RESPONSE
  INTERNAL_NOTE
  ATTRIBUTE_DETECTED
  ATTRIBUTE_UPDATED
  TAG_ADDED
  LEAD_SCORE_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  TASK_CREATED
  TASK_COMPLETED
  TICKET_CREATED
  TICKET_UPDATED
  ESCALATION_CREATED
  ESCALATION_RESOLVED
  FEEDBACK_RECEIVED
  DOCUMENT_CITED
  KNOWLEDGE_GAP_DETECTED
  CONFLICT_DETECTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskType {
  FOLLOW_UP
  CALL
  EMAIL
  REVIEW
  DEMO
  MEETING
  SUPPORT
  OTHER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum PropertyType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  REFERENCE
}

enum RuleTrigger {
  CONVERSATION_STARTED
  ATTRIBUTE_CHANGED
  LEAD_SCORE_CHANGED
  DEAL_STAGE_CHANGED
  TICKET_CREATED
  NEGATIVE_FEEDBACK
  KNOWLEDGE_GAP_CREATED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum KnowledgeGapStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum KnowledgeConflictStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum EvaluationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================================
// Workspace & Multi-Tenancy
// ============================================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             WorkspaceMember[]
  contacts            Contact[]
  companies           Company[]
  conversations       Conversation[]
  pipelines           Pipeline[]
  deals               Deal[]
  tasks               Task[]
  tickets             Ticket[]
  tags                Tag[]
  propertyDefinitions PropertyDefinition[]
  automationRules     AutomationRule[]
  outboxEvents        OutboxEvent[]
  backgroundJobs      BackgroundJob[]
  knowledgeBases      KnowledgeBase[]
  activities          CrmActivity[]

  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(AGENT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ============================================================================
// Identity and access
// ============================================================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  externalId   String?    @unique
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  isDemo       Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions            Session[]
  workspaceMemberships WorkspaceMember[]
  knowledgeBases      KnowledgeBase[]
  uploadedDocuments   Document[]        @relation("DocumentUploader")
  conversations       Conversation[]
  feedback            Feedback[]
  escalations         Escalation[]      @relation("EscalationRequester")
  assignedEscalations  Escalation[]     @relation("EscalationAssignee")
  ownedContacts       Contact[]         @relation("ContactOwner")
  ownedCompanies      Company[]         @relation("CompanyOwner")
  ownedDeals          Deal[]            @relation("DealOwner")
  ownedTasks          Task[]            @relation("TaskOwner")
  assignedTickets     Ticket[]          @relation("TicketAssignee")
  auditLogs           AuditLog[]

  @@index([role])
  @@index([status])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  expiresAt     DateTime
  ipHash        String?
  userAgentHash String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  identifierHash String
  successful     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([identifierHash, createdAt])
}

// ============================================================================
// CRM Core Entities
// ============================================================================

model Contact {
  id                String         @id @default(cuid())
  workspaceId       String
  firstName         String?
  lastName          String?
  displayName       String
  primaryEmail      String?
  normalizedEmail   String?
  phone             String?
  visitorKey        String?
  lifecycleStage    LifecycleStage @default(LEAD)
  leadStatus        LeadStatus     @default(NEW)
  leadScore         Int            @default(0)
  leadTier          String         @default("Unqualified")
  scoreFactors      Json?
  ownerId           String?
  companyId         String?
  source            String         @default("Website Chat")
  sourceDetail      String?
  preferredLanguage String         @default("en")
  timezone          String?
  firstSeenAt       DateTime       @default(now())
  lastSeenAt        DateTime       @default(now())
  lastContactedAt   DateTime?
  lastActivityAt    DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  archivedAt        DateTime?

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User?                 @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company        Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  activities     CrmActivity[]
  deals          Deal[]
  tasks          Task[]
  tickets        Ticket[]
  intelligence   CustomerIntelligence?
  consents       ConsentRecord[]
  propertyValues PropertyValue[]

  @@unique([workspaceId, normalizedEmail])
  @@index([workspaceId, visitorKey])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, leadStatus])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, lastActivityAt])
}

model Company {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  domain         String?
  website        String?
  industry       String?
  employeeRange  String?
  country        String?
  lifecycle      LifecycleStage @default(LEAD)
  ownerId        String?
  source         String         @default("Organic")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastActivityAt DateTime       @default(now())

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User?         @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  tasks      Task[]
  tickets    Ticket[]
  activities CrmActivity[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, name])
  @@index([workspaceId, ownerId])
}

model CrmActivity {
  id             String          @id @default(cuid())
  workspaceId    String
  contactId      String?
  companyId      String?
  conversationId String?
  dealId         String?
  taskId         String?
  ticketId       String?
  actorId        String?
  type           CrmActivityType
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
}

model CustomerIntelligence {
  id                     String           @id @default(cuid())
  workspaceId            String
  contactId              String           @unique
  summary                String?
  primaryIntent          String?
  secondaryIntent        String?
  customerNeed           String?
  painPoint              String?
  productInterest        String?
  urgency                String?
  sentiment              String?
  requestedFollowUp      Boolean          @default(false)
  timeline               String?
  seatRequirement        Int?
  explicitRequirements   String[]         @default([])
  recommendedNextAction  String?
  confidence             Float            @default(0.8)
  provenance             ProvenanceSource @default(DERIVED)
  sourceMessageIds       String[]         @default([])
  humanOverride          Boolean          @default(false)
  locked                 Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId])
}

// ============================================================================
// Sales Pipeline & Deals
// ============================================================================

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([workspaceId])
}

model PipelineStage {
  id             String   @id @default(cuid())
  pipelineId     String
  name           String
  order          Int
  winProbability Float    @default(0.5)
  createdAt      DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, order])
}

model Deal {
  id                   String     @id @default(cuid())
  workspaceId          String
  name                 String
  pipelineId           String
  stageId              String
  primaryCompanyId     String?
  primaryContactId     String?
  ownerId              String?
  amount               Float?
  currency             String     @default("USD")
  probability          Float?
  expectedCloseDate    DateTime?
  source               String     @default("Chat Conversation")
  sourceConversationId String?
  status               DealStatus @default(OPEN)
  lossReason           String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  closedAt             DateTime?

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  primaryCompany Company?      @relation(fields: [primaryCompanyId], references: [id], onDelete: SetNull)
  primaryContact Contact?      @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  owner          User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          Task[]
  tickets        Ticket[]
  activities     CrmActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, stageId])
  @@index([workspaceId, ownerId])
}

// ============================================================================
// Tasks & Tickets
// ============================================================================

model Task {
  id             String       @id @default(cuid())
  workspaceId    String
  title          String
  description    String?
  type           TaskType     @default(FOLLOW_UP)
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(NORMAL)
  ownerId        String?
  dueAt          DateTime?
  contactId      String?
  companyId      String?
  dealId         String?
  ticketId       String?
  conversationId String?
  createdBy      String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User?         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]

  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, ownerId])
}

model Ticket {
  id             String       @id @default(cuid())
  workspaceId    String
  subject        String
  description    String?
  status         TicketStatus @default(NEW)
  priority       TaskPriority @default(NORMAL)
  contactId      String?
  companyId      String?
  dealId         String?
  conversationId String?
  assigneeId     String?
  category       String?
  productArea    String?
  urgency        String?
  escalationId   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  escalation   Escalation?   @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  tasks        Task[]
  activities   CrmActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
}

// ============================================================================
// Tags and Dynamic Custom Properties
// ============================================================================

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model PropertyDefinition {
  id           String       @id @default(cuid())
  workspaceId  String
  targetEntity String
  name         String
  key          String
  type         PropertyType
  options      String[]     @default([])
  required     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    PropertyValue[]

  @@unique([workspaceId, targetEntity, key])
}

model PropertyValue {
  id           String   @id @default(cuid())
  definitionId String
  contactId    String?
  value        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition PropertyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  contact    Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@index([contactId])
}

// ============================================================================
// Automation Engine
// ============================================================================

model AutomationRule {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String?
  trigger     RuleTrigger
  conditions  Json
  actions     Json
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, trigger, active])
}

// ============================================================================
// Durable Event System (Outbox & Background Worker)
// ============================================================================

model OutboxEvent {
  id            String       @id @default(cuid())
  workspaceId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
}

model BackgroundJob {
  id            String    @id @default(cuid())
  workspaceId   String
  jobType       String
  payload       Json
  status        JobStatus @default(QUEUED)
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  claimedBy     String?
  lastError     String?
  correlationId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
}

model ConsentRecord {
  id        String   @id @default(cuid())
  contactId String
  purpose   String
  granted   Boolean  @default(true)
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// ============================================================================
// Knowledge sources
// ============================================================================

model KnowledgeBase {
  id          String     @id @default(cuid())
  workspaceId String?
  name        String
  slug        String     @unique
  description String?
  visibility  Visibility @default(INTERNAL)
  ownerId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace          Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner              User?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  documents          Document[]
  conversations      Conversation[]
  knowledgeGaps      KnowledgeGap[]
  knowledgeConflicts KnowledgeConflict[]
  evaluations        Evaluation[]

  @@index([visibility])
  @@index([workspaceId])
}

model Document {
  id               String         @id @default(cuid())
  knowledgeBaseId  String
  title            String
  originalFilename String?
  sourceType       SourceType
  mimeType         String?
  storagePath      String?
  sourceUrl        String?
  checksum         String
  status           DocumentStatus @default(UPLOADED)
  accessLevel      AccessLevel    @default(PUBLIC)
  language         String         @default("en")
  fileSize         Int            @default(0)
  pageCount        Int?
  chunkCount       Int            @default(0)
  currentVersion   Int            @default(1)
  lastError        String?
  uploadedBy       String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  knowledgeBase          KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  uploader               User?                    @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  versions               DocumentVersion[]
  chunks                 DocumentChunk[]
  jobs                   IngestionJob[]
  citations              Citation[]
  gapSuggestions         KnowledgeGapSuggestion[]
  authoritativeConflicts KnowledgeConflict[]       @relation("AuthoritativeConflictDoc")
  supersededConflicts    KnowledgeConflict[]       @relation("SupersededConflictDoc")
  conflictDocs           KnowledgeConflictDoc[]

  @@unique([knowledgeBaseId, checksum])
  @@index([status])
  @@index([accessLevel])
  @@index([knowledgeBaseId, status])
}

model DocumentVersion {
  id                  String           @id @default(cuid())
  documentId          String
  version             Int
  checksum            String
  storagePath         String?
  processingStatus    ProcessingStatus @default(PENDING)
  extractedText       String?
  pageCount           Int?
  embeddingProvider   String?
  embeddingModel      String?
  embeddingDimensions Int?
  createdAt           DateTime         @default(now())

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]

  @@unique([documentId, version])
  @@index([processingStatus])
}

model DocumentChunk {
  id                String                    @id @default(cuid())
  documentId        String
  documentVersionId String
  chunkIndex        Int
  content           String
  tokenCount        Int                       @default(0)
  pageNumber        Int?
  sectionTitle      String?
  accessLevel       AccessLevel
  knowledgeBaseId   String
  searchText        String                    @default("")
  metadata          Json?
  embeddingProvider String?
  embeddingModel    String?
  embedding         Unsupported("vector(768)")?
  createdAt         DateTime                  @default(now())

  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  citations       Citation[]

  @@unique([documentVersionId, chunkIndex])
  @@index([documentId])
  @@index([accessLevel])
  @@index([knowledgeBaseId, accessLevel])
}

// ============================================================================
// Conversations
// ============================================================================

model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String?
  userId          String?
  contactId       String?
  knowledgeBaseId String?
  title           String             @default("New conversation")
  status          ConversationStatus @default(ACTIVE)
  anonymousKey    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  messages      Message[]
  escalations   Escalation[]
  retrievalLogs RetrievalLog[]
  tasks         Task[]
  tickets       Ticket[]
  activities    CrmActivity[]

  @@index([workspaceId, updatedAt])
  @@index([userId, updatedAt])
  @@index([contactId, updatedAt])
  @@index([anonymousKey])
  @@index([status])
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  confidence     Float?
  grounded       GroundingLevel?
  modelProvider  String?
  modelName      String?
  latencyMs      Int?
  flagged        Boolean         @default(false)
  createdAt      DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    Citation[]
  feedback     Feedback[]

  @@index([conversationId, createdAt])
}

model Citation {
  id             String   @id @default(cuid())
  messageId      String
  documentId     String
  chunkId        String?
  pageNumber     Int?
  sectionTitle   String?
  excerpt        String
  relevanceScore Float    @default(0)
  ordinal        Int      @default(0)
  createdAt      DateTime @default(now())

  message  Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([documentId])
}

model Feedback {
  id        String          @id @default(cuid())
  messageId String
  userId    String?
  rating    FeedbackRating
  reason    FeedbackReason?
  comment   String?
  reviewed  Boolean         @default(false)
  createdAt DateTime        @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([rating])
  @@index([reviewed])
  @@index([messageId])
}

model Escalation {
  id                 String                       @id @default(cuid())
  conversationId     String
  userId             String?
  reason             String
  summary            String
  suggestedReply     String?
  priority           EscalationPriority           @default(NORMAL)
  status             EscalationStatus             @default(OPEN)
  assignedTo         String?
  resolutionNote     String?
  resolutionCategory EscalationResolutionCategory?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation("EscalationRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("EscalationAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  tickets      Ticket[]

  @@index([status, priority])
  @@index([conversationId])
}

// ============================================================================
// Operations
// ============================================================================

model IngestionJob {
  id            String    @id @default(cuid())
  documentId    String
  status        JobStatus @default(QUEUED)
  stage         JobStage  @default(VALIDATION)
  progress      Int       @default(0)
  attemptCount  Int       @default(0)
  lastError     String?
  correlationId String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([documentId, createdAt])
}

model RetrievalLog {
  id                String          @id @default(cuid())
  conversationId    String?
  query             String
  rewrittenQuery    String?
  retrievedChunkIds String[]        @default([])
  rerankedChunkIds  String[]        @default([])
  candidateCount    Int             @default(0)
  filteredCount     Int             @default(0)
  confidence        Float           @default(0)
  grounding         GroundingLevel?
  accessLevel       AccessLevel
  latencyMs         Int             @default(0)
  traceId           String?
  createdAt         DateTime        @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  metadata     Json?
  ipHash       String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Integration {
  id                    String            @id @default(cuid())
  type                  String
  name                  String
  status                IntegrationStatus @default(NOT_CONFIGURED)
  configurationMetadata Json?
  lastCheckedAt         DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([type, name])
  @@index([status])
}

// ============================================================================
// Knowledge Health
// ============================================================================

model KnowledgeGap {
  id               String                   @id @default(cuid())
  knowledgeBaseId  String
  title            String
  description      String?
  status           KnowledgeGapStatus       @default(OPEN)
  occurrenceCount  Int                      @default(1)
  lastOccurredAt   DateTime                 @default(now())
  firstDetectedAt  DateTime                 @default(now())
  resolvedAt       DateTime?
  resolutionNote   String?
  knowledgeBase    KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  suggestedSources KnowledgeGapSuggestion[]

  @@index([knowledgeBaseId, status])
  @@index([status])
}

model KnowledgeGapSuggestion {
  id             String       @id @default(cuid())
  knowledgeGapId String
  documentId     String
  relevanceNote  String?
  knowledgeGap   KnowledgeGap @relation(fields: [knowledgeGapId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeGapId, documentId])
}

model KnowledgeConflict {
  id                 String                  @id @default(cuid())
  knowledgeBaseId    String
  title              String
  description        String?
  status             KnowledgeConflictStatus @default(OPEN)
  authoritativeDocId String?
  supersededDocId    String?
  resolutionNote     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  resolvedAt         DateTime?
  knowledgeBase      KnowledgeBase           @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  authoritativeDoc   Document?               @relation("AuthoritativeConflictDoc", fields: [authoritativeDocId], references: [id], onDelete: SetNull)
  supersededDoc      Document?               @relation("SupersededConflictDoc", fields: [supersededDocId], references: [id], onDelete: SetNull)
  conflictingDocs    KnowledgeConflictDoc[]

  @@index([knowledgeBaseId, status])
  @@index([status])
}

model KnowledgeConflictDoc {
  id                  String            @id @default(cuid())
  knowledgeConflictId String
  documentId          String
  excerpt             String
  knowledgeConflict   KnowledgeConflict @relation(fields: [knowledgeConflictId], references: [id], onDelete: Cascade)
  document            Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeConflictId, documentId])
}

// ============================================================================
// Evaluations
// ============================================================================

model Evaluation {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  name            String
  description     String?
  testCases       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeBase KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  runs          EvaluationRun[]

  @@index([knowledgeBaseId])
}

model EvaluationRun {
  id           String              @id @default(cuid())
  evaluationId String
  status       EvaluationRunStatus @default(PENDING)
  total        Int                 @default(0)
  passed       Int                 @default(0)
  failed       Int                 @default(0)
  error        String?
  durationMs   Int?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([status])
}
